[push]
	default = simple
[color]
	ui = auto
[merge "ours"]
	name = keep ours
	driver = true
[init]
	defaultBranch = main
[fetch]
	prune = true
	pruneTags = true
[gui]
	pruneDuringFetch = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
	side-by-side = true
	line-numbers = true
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B --base-name %S --left-name %X --right-name %Y --path-name %P --conflict-marker-size %L
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
