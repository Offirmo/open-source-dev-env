### common/user--010ensure--settings--shell.sh
### common/user--020ensure--present--ssh.sh
ssh-keygen -a 100 -t ed25519 -C $USER -f ~/.ssh/id_ed25519
open https://github.com/settings/keys
open https://bitbucket.org/account/settings/ssh-keys/
ssh-keygen -a 100 -t ed25519 -C offirmo.net@gmail.com -f ~/.ssh/id_ed25519_offirmo
open https://github.com/settings/keys
open https://bitbucket.org/account/settings/ssh-keys/
### common/user--050ensure--pkg-mgr.sh
brew update
ssh-keygen -R github.com -f ~/.ssh/known_hosts
### common/user--099ensure--cloned--ode_repo.sh
git clone --recursive https://github.com/Offirmo/open-source-dev-env.git open-source-dev-env
### macos/user--100ensure--settings.sh
defaults write com.apple.Finder AppleShowAllFiles -bool true
defaults write NSGlobalDomain AppleShowAllExtensions -bool true
defaults write com.apple.finder _FXShowPosixPathInTitle -bool true
defaults write com.apple.finder DisableAllAnimations -bool true
